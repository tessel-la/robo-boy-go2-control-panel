  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tessel-la/robo-boy-go2-control-panel.git"
  },
  "files": [
    "dist",
    "roboboy.panel.json",
    "README.md",
    "examples"
  ],
  "exports": "./dist/index.js",
